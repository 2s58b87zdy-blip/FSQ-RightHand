# Authentication
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
INITIAL_OWNER_NAME=Flemming
INITIAL_OWNER_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Azure SQL (use Managed Identity by leaving SQL_USER and SQL_PASSWORD empty)
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=fsq-command
SQL_PORT=1433
SQL_USER=
SQL_PASSWORD=
DATABASE_URL=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=fsq-documents

# ATLAS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_VECTOR_STORE_ID=

# Fleet Map · free AISstream.io key
AISSTREAM_API_KEY=
